# Shared / repo-root environment. Copy to .env and fill in.
# Per-service files: web/backend/.env, ai-ml/.env, chatbot/rag-engine/.env,
# web/frontend/.env -- each has its own .env.example.

# Secrets. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY must be identical here and in web/backend/.env and
# chatbot/rag-engine/.env (the backend signs, the rag-engine verifies).
JWT_SECRET_KEY=
INTERNAL_SERVICE_KEY=

# Groq LLM. Leave empty when you have no key: the services then take their
# documented "AI not configured" fallback instead of failing on a bad key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Vector store. The code's built-in default is a stale absolute path, so set
# this to your checkout's chroma_data directory.
CHROMA_DB_PATH=C:\path\to\QuantumLearningWorkspace\chroma_data
# Chroma Cloud instead (all three required together):
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

# Embeddings / chunking (must match the existing study_chunks collection)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# MongoDB. Empty = the backend's in-memory fallback (data lost on restart).
MONGODB_URI=
MONGODB_DB_NAME=study_mind_db
# Local mongod instead:
# MONGODB_URI=mongodb://localhost:27017
# USE_LOCAL_MONGO=1

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
