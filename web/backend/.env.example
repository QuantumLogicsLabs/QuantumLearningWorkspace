MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/
MONGODB_DB_NAME=study_mind_db
JWT_SECRET_KEY=<your-secret-key-here>
INTERNAL_SERVICE_KEY=<your-internal-service-key-here>

WEB_API_URL=http://localhost:5000
CHATBOT_SERVICE_URL=http://localhost:8000
INGESTION_SERVICE_URL=http://localhost:8001
QUIZ_SERVICE_URL=http://localhost:8002

# Email OTP Verification (Optional for local dev; if omitted, OTP logs to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password

# OAuth Configuration (Google & GitHub Sign-In)
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5000/auth/github/callback